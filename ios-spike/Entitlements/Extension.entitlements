<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Both extensions need this too, not just the app. An extension missing the
	     family-controls entitlement fails to load with no useful error: the shield
	     silently falls back to the system default and the action button does nothing. -->
	<key>com.apple.developer.family-controls</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.aadarsh.instakiller</string>
	</array>
</dict>
</plist>
